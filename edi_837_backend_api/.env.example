# Application
APP_NAME="EDI 837 Processing API"
ENV="development"
LOG_LEVEL="INFO"

# Azure
AZURE_STORAGE_CONNECTION_STRING="REPLACE_WITH_CONNECTION_STRING"

# Defaults
INPUT_CONTAINER_DEFAULT="incoming"
OUTPUT_CONTAINER_DEFAULT="processed"
OUTPUT_PREFIX_DEFAULT="out/"

# Blob client settings
BLOB_REQUEST_TIMEOUT_SECS=60
BLOB_MAX_RETRIES=3
ALLOW_OVERWRITE=false

# API
REQUEST_MAX_BODY_MB=20
