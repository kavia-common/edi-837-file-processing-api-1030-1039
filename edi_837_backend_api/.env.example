# Application
APP_NAME="EDI 837 Processing API"
ENV="development"
LOG_LEVEL="INFO"

# Azure Storage
# Obtain a connection string from Azure Portal > Storage account > Access keys.
# Do NOT commit real credentials. Copy this template to .env and set values locally.
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net"

# Defaults
INPUT_CONTAINER_DEFAULT="incoming"
OUTPUT_CONTAINER_DEFAULT="processed"
OUTPUT_PREFIX_DEFAULT="out/"

# Blob client behavior
BLOB_REQUEST_TIMEOUT_SECS=60
BLOB_MAX_RETRIES=3
ALLOW_OVERWRITE=false

# Request limits
REQUEST_MAX_BODY_MB=20
